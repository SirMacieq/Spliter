import { useCallback } from 'react';
import {
  transact,
  Web3MobileWallet,
} from '@solana-mobile/mobile-wallet-adapter-protocol-web3js';
import { PublicKey } from '@solana/web3.js';
import { useWalletStore } from '../stores/walletStore';
import { APP_NAME, getSolanaNetwork } from '../lib/constants';

const APP_IDENTITY = {
  name: APP_NAME,
  uri: 'https://spliter.app',
  // ważne: w MWA icon powinien być URL albo base64 data URL; lokalne "favicon.ico" bywa problematyczne
  // zostawiamy bez icon, żeby nie psuć autoryzacji
  // icon: 'https://spliter.app/favicon.ico',
};

export const useWalletConnection = () => {
  const { setConnecting, setConnected, setDisconnected, setError } =
    useWalletStore();

  const connect = useCallback(async () => {
    setConnecting();

    try {
      await transact(async (wallet: Web3MobileWallet) => {
        const authResult = await wallet.authorize({
          cluster: getSolanaNetwork(),
          identity: APP_IDENTITY,
        });

        const rawAddress = authResult.accounts?.[0]?.address;
        console.log('DEBUG rawAddress =', rawAddress);

        let publicKey: PublicKey;

        if (typeof rawAddress === 'string') {
          const cleaned = rawAddress
            .trim()
            .replace(/^solana:/i, '')
            .replace(/^sol:/i, '');

          console.log('DEBUG cleaned address =', cleaned);
          publicKey = new PublicKey(cleaned);
        } else if (rawAddress instanceof Uint8Array) {
          publicKey = new PublicKey(rawAddress);
        } else if (Array.isArray(rawAddress)) {
          publicKey = new PublicKey(Uint8Array.from(rawAddress));
        } else {
          throw new Error('Wallet returned address in unknown format.');
        }

        setConnected(publicKey.toBase58());
      });
    } catch (error: any) {
      console.error('Wallet connection error:', error);

      if (error?.message?.includes('User rejected')) {
        setError('Connection cancelled');
      } else if (error?.message?.includes('No wallet')) {
        setError('No wallet app found. Please install Phantom or another Solana wallet.');
      } else {
        setError(error?.message || 'Failed to connect wallet');
      }

      setTimeout(() => setDisconnected(), 3000);
    }
  }, [setConnecting, setConnected, setDisconnected, setError]);

  const disconnect = useCallback(() => {
    setDisconnected();
  }, [setDisconnected]);

  return { connect, disconnect };
};
